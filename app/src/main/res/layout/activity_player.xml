<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/player_bg">

    <com.shuyu.gsyvideoplayer.video.StandardGSYVideoPlayer
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:indeterminate="true"
        android:indeterminateTint="@color/player_accent"
        android:visibility="gone" />

    <!-- 右上角操作条：整体一个半透明胶囊，3 秒自动淡出 -->
    <LinearLayout
        android:id="@+id/actions"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="6dp"
        android:layout_marginRight="8dp"
        android:background="@drawable/player_chip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="4dp"
        android:paddingRight="4dp">

        <ImageButton
            android:id="@+id/btn_prev"
            style="@style/PlayerBtn"
            android:contentDescription="@string/ep_prev"
            android:src="@drawable/ic_prev"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_next"
            style="@style/PlayerBtn"
            android:contentDescription="@string/ep_next"
            android:src="@drawable/ic_next"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/btn_eps"
            style="@style/PlayerBtn"
            android:contentDescription="@string/ep_pick"
            android:src="@drawable/ic_swap"
            android:visibility="gone" />

        <View
            android:id="@+id/divider1"
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="#33E4EEEC"
            android:visibility="gone" />

        <TextView
            android:id="@+id/btn_speed"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:minWidth="50dp"
            android:paddingLeft="6dp"
            android:paddingRight="6dp"
            android:text="1.0×"
            android:textColor="@color/player_accent"
            android:textSize="13sp"
            android:textStyle="bold" />

        <View
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginLeft="2dp"
            android:layout_marginRight="2dp"
            android:background="#33E4EEEC" />

        <ImageButton
            android:id="@+id/btn_fav"
            style="@style/PlayerBtn"
            android:contentDescription="@string/mn_fav"
            android:src="@drawable/ic_star" />

        <ImageButton
            android:id="@+id/btn_lines"
            style="@style/PlayerBtn"
            android:contentDescription="@string/mn_lines"
            android:src="@drawable/ic_list" />
    </LinearLayout>
</FrameLayout>
